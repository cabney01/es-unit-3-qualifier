/** Honors Chemistry Unit 1 (1A–1C) score receiver. Deploy as Apps Script web app bound to a NEW Google Sheet. 
 * NOTE: For a real server-side two-attempt limit, implement a verified student identity / authenticated login. 
 * Names entered by students are not verified; do not treat browser-side limits as tamper-proof.
 */
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(20000);const p=JSON.parse((e.postData&&e.postData.contents)||'{}');const n=clean_(p.name,100),b=clean_(p.block,60),eText=clean_(p.essay,10000),c=Number(p.correct),t=Number(p.total),sec=Number(p.durationSeconds);if(!n||!b||eText.length<40||t!==24||!Number.isInteger(c)||c<0||c>t||!Number.isFinite(sec)||sec<0)return json_({ok:false,error:'Invalid attempt'});const ss=SpreadsheetApp.getActiveSpreadsheet();let sheet=ss.getSheetByName('All Attempts');if(!sheet){sheet=ss.insertSheet('All Attempts');sheet.appendRow(['Timestamp','Student','Block','Attempt','Correct','Total','Percent','Missed Questions','Practice Paragraph','Seconds','Status'])}const last=sheet.getLastRow();const prev=last>1?sheet.getRange(2,2,last-1,2).getDisplayValues():[];const used=prev.filter(r=>r[0].trim().toLowerCase()===n.toLowerCase()&&r[1].trim().toLowerCase()===b.toLowerCase()).length;if(used>=2)return json_({ok:false,error:'Two attempts already submitted'});const missed=Array.isArray(p.missed)?p.missed.slice(0,24).map(x=>clean_(x,180)).join('; '):'';sheet.getRange(last+1,1,1,11).setValues([[new Date(),n,b,used+1,c,t,Math.round(c/t*100),missed,eText,Math.round(sec),'Completed']]);sheet.getRange(last+1,1).setNumberFormat('mmm d, yyyy h:mm AM/PM');let best=ss.getSheetByName('Highest Scores');if(!best){best=ss.insertSheet('Highest Scores');best.appendRow(['Student','Block','Highest Percent','Correct','Attempt','Last Updated'])}const rows=best.getLastRow()>1?best.getRange(2,1,best.getLastRow()-1,6).getValues():[];const ix=rows.findIndex(r=>String(r[0]).toLowerCase()===n.toLowerCase()&&String(r[1]).toLowerCase()===b.toLowerCase());const pc=Math.round(c/t*100);if(ix<0)best.appendRow([n,b,pc,c,used+1,new Date()]);else if(pc>Number(rows[ix][2]))best.getRange(ix+2,1,1,6).setValues([[n,b,pc,c,used+1,new Date()]]);return json_({ok:true,attempt:used+1})}catch(err){return json_({ok:false,error:String(err)})}finally{try{lock.releaseLock()}catch(_){}}}
function doGet(){return json_({ok:true,message:'Honors Chemistry Unit 1 quiz receiver online'})}
function clean_(v,max){let s=String(v==null?'':v).trim().slice(0,max);return /^[=+@\-]/.test(s)?"'"+s:s}
function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
